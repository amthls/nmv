# ============================================================================
# NOVEL & MANGA PLATFORM - ENVIRONMENT TEMPLATE
# ============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=novel_platform
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full Database Connection String
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/novel_platform?schema=public

# Backend API Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_NAME="NovelHub"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional pgAdmin Port
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@novelhub.vn
PGADMIN_DEFAULT_PASSWORD=change-me

# Search (story search), served by Elasticsearch (the `search` container).
# Leave SEARCH_URL empty to use plain SQL search.
SEARCH_URL=http://localhost:9201
SEARCH_INDEX=novel_stories
SEARCH_PORT=9201

# RabbitMQ (notification queue). Required. Use a random password (hex avoids URL-escaping issues)
RABBITMQ_URL=amqp://novel:change-me@localhost:5672
RABBITMQ_USER=novel
RABBITMQ_PASSWORD=change-me
RABBITMQ_MANAGEMENT_PORT=15673

# Redis (cache, view counters, shared rate limits, realtime). Required by docker compose. Random hex.
REDIS_PASSWORD=change-me
REDIS_PORT=6380

# Elasticsearch password (user elastic). Random hex. Fixed once the search volume is created with it
ELASTIC_PASSWORD=change-me

# identity service (Go): its database password and the key signing nh_access cookies. Random hex, launch.py fills them in
IDENTITY_DB_PASSWORD=change-me
IDENTITY_JWT_SECRET=change-me
# Optional Cloudflare Turnstile bot check on sign-up / forgot password: set both (empty = off), then rebuild frontend
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Keys between services, one per receiving service (random hex, launch.py fills them in):
# USER_SIG_KEY_* sign the X-User-* headers identity gives the gateway for that service; INTERNAL_KEY_* sign calls to it
USER_SIG_KEY_BACKEND=change-me
USER_SIG_KEY_WORKSPACE=change-me
USER_SIG_KEY_MEDIA=change-me
USER_SIG_KEY_MESSAGING=change-me
INTERNAL_KEY_BACKEND=change-me
INTERNAL_KEY_IDENTITY=change-me
INTERNAL_KEY_WORKSPACE=change-me
INTERNAL_KEY_MESSAGING=change-me
# workspace service (Go): its database password. Random hex, launch.py fills it in
WORKSPACE_DB_PASSWORD=change-me
# media service (TS): its database password. Random hex, launch.py fills it in
MEDIA_DB_PASSWORD=change-me
# messaging service (Go): its database password. Random hex, launch.py fills it in
MESSAGING_DB_PASSWORD=change-me

# Backup (restic repository ./backups/repo). Random hex. KEEP A COPY ELSEWHERE: without it the backups can't be read
RESTIC_PASSWORD=change-me

# Public demo-account list on the login form (keep false when reachable from the Internet)
ENABLE_DEMO_ACCOUNTS=false
