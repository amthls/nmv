{
  "name": "novel-platform-catalog",
  "version": "1.0.0",
  "description": "RESTful API Backend for Novel & Manga Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/server.js",
    "db:check": "tsx scripts/check-db.ts",
    "db:import": "tsx scripts/import-sql.ts",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "~7.0.13",
    "pg": "^8.23.1",
    "rate-limit-redis": "^4",
    "sanitize-html": "^2.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
